	quest.7B2E2427787A55A7.quest_desc: [
		"With the &6Everlasting Upgrade&r, your backpack won't get destroyed by anything!"
		""
		"This includes, but is not limited to:"
		"> &4Lava"
		"> &8Void"
		"> &2Creepers"
		"> &bDespawning"
		"> &6And more!"
	]
